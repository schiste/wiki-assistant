#!/bin/sh
# Generates and provisions a strong random API_SERVER_KEY through Toolforge envvars (#30).
#
# API_SERVER_KEY has one source of truth (architecture §13): this Toolforge envvar, injected
# into both the internal Hermes job and the public proxy. Neither process may generate or
# persist an independent key — see gateway/run.py's _read_required_api_server_key, which fails
# closed if the envvar is absent or too short.
set -eu

if ! command -v toolforge >/dev/null 2>&1; then
    echo "generate-api-server-key: run this inside the Toolforge tool account" >&2
    exit 1
fi

key_file="$(mktemp "${TMPDIR:-/tmp}/wait-api-server-key.XXXXXX")"
trap 'rm -f "$key_file"' EXIT INT TERM

python3 -c 'import secrets; print(secrets.token_hex(32), end="")' > "$key_file"
chmod 600 "$key_file"

if [ "$(wc -c < "$key_file" | tr -d ' ')" -ne 64 ]; then
    echo "generate-api-server-key: generated value has an unexpected length" >&2
    exit 1
fi

if ! toolforge envvars create API_SERVER_KEY < "$key_file" >/dev/null; then
    echo "generate-api-server-key: Toolforge rejected the envvar update" >&2
    exit 1
fi

echo "Provisioned API_SERVER_KEY; restart both the gateway and proxy now" >&2
